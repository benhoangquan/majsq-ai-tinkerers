# Leave DATABASE_URL unset to use the local SQLite database.
# PostgreSQL deployments should provide a Django-compatible PostgreSQL driver.
# DATABASE_URL=postgresql://majsq:password@localhost:5432/majsq
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.example.com
# Set to 0 only until every HTTPS subdomain is ready for HSTS preload.
DJANGO_HSTS_PRELOAD=1

TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-value
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=majsq_bot
# Telegram's numeric bot ID is recommended so group replies can be matched
# exactly (instead of relying on the bot username).
TELEGRAM_BOT_ID=
PUBLIC_BASE_URL=https://api.example.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FESTRO_MOCK=1
FESTRO_API_URL=
FESTRO_TOKEN_URL=https://festro.com/oauth/token
FESTRO_CLIENT_ID=
FESTRO_CLIENT_SECRET=
